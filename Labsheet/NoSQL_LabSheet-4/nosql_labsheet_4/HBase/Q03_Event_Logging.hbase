# Q3: Event logging table; row key is event ID
create 'EventLog', 'event', 'user', 'state'
put 'EventLog', 'EVT#1001', 'event:timestamp', '2026-10-09T10:00:00Z'
put 'EventLog', 'EVT#1001', 'event:type', 'LOGIN'
put 'EventLog', 'EVT#1001', 'user:user_id', 'U101'
put 'EventLog', 'EVT#1001', 'user:ip', '192.0.2.10'
put 'EventLog', 'EVT#1001', 'state:status', 'SUCCESS'
put 'EventLog', 'EVT#1002', 'event:timestamp', '2026-10-09T10:05:00Z'
put 'EventLog', 'EVT#1002', 'event:type', 'PURCHASE'
put 'EventLog', 'EVT#1002', 'user:user_id', 'U102'
put 'EventLog', 'EVT#1002', 'user:ip', '192.0.2.11'
put 'EventLog', 'EVT#1002', 'state:status', 'PENDING'
get 'EventLog', 'EVT#1001'
get 'EventLog', 'EVT#1002'
scan 'EventLog'
