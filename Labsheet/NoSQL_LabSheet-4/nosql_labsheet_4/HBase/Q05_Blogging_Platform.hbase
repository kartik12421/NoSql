# Q5: Blogging platform with three sample blogs
create 'Blog', 'details', 'author', 'comments'
put 'Blog', 'BLOG#001', 'details:title', 'Getting Started with HBase'
put 'Blog', 'BLOG#001', 'details:body', 'HBase is a distributed wide-column database.'
put 'Blog', 'BLOG#001', 'author:name', 'Aarav'
put 'Blog', 'BLOG#001', 'author:id', 'A101'
put 'Blog', 'BLOG#001', 'comments:C001', 'Very useful post'
put 'Blog', 'BLOG#002', 'details:title', 'Cassandra Basics'
put 'Blog', 'BLOG#002', 'details:body', 'Cassandra is designed for distributed availability.'
put 'Blog', 'BLOG#002', 'author:name', 'Diya'
put 'Blog', 'BLOG#002', 'author:id', 'A102'
put 'Blog', 'BLOG#002', 'comments:C001', 'Thanks for explaining'
put 'Blog', 'BLOG#003', 'details:title', 'Choosing a Row Key'
put 'Blog', 'BLOG#003', 'details:body', 'Row-key design affects data access and distribution.'
put 'Blog', 'BLOG#003', 'author:name', 'Kabir'
put 'Blog', 'BLOG#003', 'author:id', 'A103'
put 'Blog', 'BLOG#003', 'comments:C001', 'Good example'
get 'Blog', 'BLOG#002'
scan 'Blog'
